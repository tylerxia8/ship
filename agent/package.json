{
  "name": "@ship/agent",
  "version": "0.0.0",
  "private": true,
  "description": "FleetGraph — project intelligence agent for Ship. LangGraph.js graph with proactive (poll-driven) + on-demand (chat-driven) modes against Ship's unified document model.",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "test": "vitest run src",
    "type-check": "tsc --noEmit",
    "clean": "rm -rf dist",
    "hello-world": "tsx src/scripts/hello-world.ts",
    "trace-matrix": "tsx src/scripts/list-use-case-traces.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.98.0",
    "@langchain/anthropic": "latest",
    "@langchain/core": "latest",
    "@langchain/langgraph": "latest",
    "@langchain/langgraph-checkpoint-postgres": "latest",
    "@ship/sdk": "workspace:*",
    "@ship/shared": "workspace:*",
    "express": "^4.21.2",
    "langsmith": "latest",
    "pg": "^8.13.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.19.3",
    "@types/pg": "^8.11.10",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
